load("@rules_cc//cc:defs.bzl", "cc_library")
  

cc_library(
    name = "@@NAME@@",
    includes = @@INCLUDE_SEARCH_DIR@@,
    hdrs = glob(@@HEADERS@@),
    @@LIBS@@,
    include_prefix = "@@PREFIX@@",
    strip_include_prefix = "@@STRIP_PREFIX@@",
    visibility = ["//visibility:public"],
    deps = @@DEPS@@,
)