# Auto generated by buildtool of apollo

STATUS = {{ status }}

SOURCE = {
    {% for pkg in sources %}"{{ pkg.name }}" : {
        "path": "{{ pkg.path }}",
        "depends": [
            {% for dep in pkg.depends %}"{{ dep }}",
            {% endfor %}
        ],
    },
    {% endfor %}
}

BINARY = {
    {% for pkg in binaries %}"{{ pkg.name }}" : {
        "path": "{{ pkg.path }}",
        "targets": [
            {% for t in pkg.targets %}"{{ t }}",
            {% endfor %}
        ],
    },
    {% endfor %}
}
