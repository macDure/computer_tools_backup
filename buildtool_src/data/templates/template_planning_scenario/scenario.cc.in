bool {{ scenario_name }}::Init(std::shared_ptr<DependencyInjector> injector,
                         const std::string& name) {
  if (init_) {
    return true;
  }

  if (!Scenario::Init(injector, name)) {
    AERROR << "failed to init scenario" << Name();
    return false;
  }

  if (!Scenario::LoadConfig<apollo{{ namespaces|format_namespace }}::{{ scenario_name }}Config>(
          &context_.scenario_config)) {
    AERROR << "fail to get config of scenario" << Name();
    return false;
  }

  // To be implemented.

  init_ = true;
  return true;
}

bool {{ scenario_name }}::IsTransferable(const Scenario* const other_scenario,
                                   const Frame& frame) {
  // To be implemented.
  return false;
}

ScenarioResult {{ scenario_name }}::Process(
    const common::TrajectoryPoint& planning_init_point, Frame* frame) {
  // To be implemented.

  return Scenario::Process(planning_init_point, frame);
}

bool {{ scenario_name }}::Enter(Frame* frame) {
  // To be implemented.

  return true;
}

bool {{ scenario_name }}::Exit(Frame* frame) {
  // To be implemented.

  return true;
}

