{
    "name": "cyber",
    "ver": "1.0.0.1",
    "arch": "amd64",
    "description": "cyber build with cpu.",
    "deps": [
        "libncurses5-dev", "libuuid1", "libatomic1", "python3", "libflann-dev",
        "apollo-neo-3rd-protobuf-dev", "apollo-neo-3rd-glog-dev", "apollo-neo-3rd-gflags-dev", "apollo-neo-3rd-fastrtps-dev"
    ],
    "include_path":"cyber",
    "src_module": "//cyber",
    "extend_ops": [
	"sed -i 's/\\#include .flann\\/general\\.h./\\#include <\\/usr\\/include\\/flann\\/general\\.h>/g' /usr/include/flann/util/params.h",
        "mkdir -p /apollo/modules",
        "mkdir -p /apollo/data/log",
	"mkdir -p /apollo/cyber",
        "chmod a+rw /apollo /apollo/modules /apollo/data /apollo/cyber",
        "chmod a+rw /opt /opt/apollo /opt/apollo/neo /opt/apollo/neo/data /opt/apollo/neo/data/log",
        "ln -snf /opt/apollo/neo/packages/cyber-dev/latest /opt/apollo/neo/packages/cyber",

    "rm -rf /apollo/cyber/conf",
    "rm -rf /apollo/cyber/data",
    
	"ln -snf /opt/apollo/neo/packages/cyber-dev/latest/conf /apollo/cyber/conf",
	"ln -snf /opt/apollo/neo/packages/cyber-dev/latest/data /apollo/cyber/data",
	"ln -snf /usr/bin/python3.6 /usr/bin/python"
    ],
    "data": [
        {
            "src": "cyber-dev/local",
            "des": "-"
        }
    ]
}
