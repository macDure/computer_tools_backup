        "ln -snf /opt/apollo/neo/packages/drivers-dev/latest/addition_data/ultrasonic_radar /apollo/modules/drivers/ultrasonic_radar",
        "ln -snf /opt/apollo/neo/packages/drivers-dev/latest/addition_data/video /apollo/modules/drivers/video"
