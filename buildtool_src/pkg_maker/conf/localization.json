{
    "name": "localization",
    "ver": "1.0.0.1",
    "arch": "amd64",
    "description": "Apollo localization module.",
    "deps": [
        "apollo-neo-cyber-dev", "apollo-neo-common-dev", "apollo-neo-common-msgs-dev", "apollo-neo-3rd-glog-dev", "apollo-neo-3rd-yaml-cpp-dev", "apollo-neo-3rd-gtest-dev",
        "apollo-neo-3rd-pcl-dev", "apollo-neo-3rd-eigen3-dev", "apollo-neo-3rd-fastrtps-dev", "apollo-neo-3rd-absl-dev", "apollo-neo-3rd-proj-dev", "apollo-neo-3rd-opencv-dev", "apollo-neo-transform-dev", "apollo-neo-3rd-localization-msf-dev",
        "apollo-neo-3rd-gflags-dev"
    ],
    "include_path":"",
    "extend_ops": [
        "mkdir -p /apollo/modules/localization/",
        "chmod a+rw /apollo/modules/localization/",

        "rm -rf /apollo/modules/localization/conf",
        "rm -rf /apollo/modules/localization/data",
        "rm -rf/apollo/modules/localization/dag",
        "rm -rf /apollo/modules/localization/launch",
        "rm -rf /apollo/modules/localization/msf",

        "ln -snf /opt/apollo/neo/packages/localization-dev/latest/conf /apollo/modules/localization/conf",
        "ln -snf /opt/apollo/neo/packages/localization-dev/latest/data /apollo/modules/localization/data",
        "ln -snf /opt/apollo/neo/packages/localization-dev/latest/dag /apollo/modules/localization/dag",
        "ln -snf /opt/apollo/neo/packages/localization-dev/latest/launch /apollo/modules/localization/launch",
        "ln -snf /opt/apollo/neo/packages/localization-dev/latest/addition_data/msf /apollo/modules/localization/msf",
        "ln -snf /usr/lib/x86_64-linux-gnu/libGLEW.so.2.0  /usr/lib/x86_64-linux-gnu/libGLEW.so.2.1"
    ],
    "data": [
        {
            "src": "localization-dev/local",
            "des": "-"
        }
    ]
}
