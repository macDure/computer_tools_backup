# Common settings: mouse support and a 100000-line pane history.
set -g mouse on
set -g history-limit 100000

# Use xclip via copy-pipe; disable OSC 52 to avoid conflicting clipboard writes.
set -s set-clipboard off

# Ubuntu 20.04 ships tmux 3.0a, which does not have the server-level
# copy-command option used by the Ubuntu 24.04/original configuration.
# Pass the xclip command directly to each copy-pipe-and-cancel binding.

# Copy mouse selections directly to the system clipboard.
bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel 'DISPLAY=:1 XAUTHORITY=/run/user/1000/gdm/Xauthority xclip -selection clipboard -i'
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel 'DISPLAY=:1 XAUTHORITY=/run/user/1000/gdm/Xauthority xclip -selection clipboard -i'

# Convenient keyboard bindings in both copy-mode key tables.
bind-key -T copy-mode Enter send-keys -X copy-pipe-and-cancel 'DISPLAY=:1 XAUTHORITY=/run/user/1000/gdm/Xauthority xclip -selection clipboard -i'
bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel 'DISPLAY=:1 XAUTHORITY=/run/user/1000/gdm/Xauthority xclip -selection clipboard -i'
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel 'DISPLAY=:1 XAUTHORITY=/run/user/1000/gdm/Xauthority xclip -selection clipboard -i'

# Save and restore sessions, windows, panes, names, layouts, and working dirs.
set -g @resurrect-dir '~/.local/share/tmux/resurrect'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @continuum-save-interval '60'
set -g @continuum-restore 'on'
set -g @continuum-boot 'on'

# Load TPM plugins after their settings; the Continuum save override follows.
run '~/.tmux/plugins/tpm/tpm'

# Continuum's periodic saves use a low-priority wrapper; Ctrl-b Ctrl-s remains
# the plugin's normal-priority manual save binding.
set-option -gF @resurrect-save-script-path '#{E:HOME}/.local/bin/tmux-resurrect-save-low-priority'
