def now_str():
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


class Log:
    def __init__(self, path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        self.file = open(path, "a", encoding="utf-8")

    def _w(self, level, msg):
        line = "%s [%s] %s" % (now_str(), level, msg)
        print(line, flush=True)
        self.file.write(line + "\n")
        self.file.flush()

    def info(self, msg):
        self._w("INFO", msg)

    def warn(self, msg):
        self._w("WARN", msg)

    def error(self, msg):
        self._w("ERROR", msg)


def load_config(path):
    """解析简单的 key = value 配置(支持 # 注释)"""
    defaults = {
        "v2rayn_dir": "/home/mac/v2rayN-linux-64",
        "test_url": "https://www.google.com/generate_204",
        "test_timeout": 8,
        "sub_timeout": 30,
        "port_base": 12301,
        "main_port": 10808,
        "prefer_after_update": "c1s1,c1s2",
        "restart_v2rayn": True,
        "backup_keep": 5,
    }
    if not os.path.exists(path):
        return defaults
    for line in open(path, encoding="utf-8"):
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, val = line.split("=", 1)
        key, val = key.strip(), val.strip()
        if key not in defaults:
            continue
        if isinstance(defaults[key], bool):
            defaults[key] = val.lower() in ("1", "true", "yes", "on")
        elif isinstance(defaults[key], int):
            defaults[key] = int(val)
        else:
            defaults[key] = val
    return defaults


def backup(path, keep, log):
    if not os.path.exists(path):
        return
    b = "%s.bak-%s" % (path, datetime.now().strftime("%Y%m%d%H%M%S"))
    shutil.copy2(path, b)
    for old in sorted(glob.glob(path + ".bak-*"))[:-keep]:
        try:
            os.remove(old)
        except OSError:
            pass


def port_free(port):
    s = socket.socket()
    try:
        s.bind(("127.0.0.1", port))
        return True
    except OSError:
        return False
    finally:
        s.close()


def wait_port(port, timeout):
    deadline = time.time() + timeout
    while time.time() < deadline:
        s = socket.socket()
        try:
            s.settimeout(1)
            s.connect(("127.0.0.1", port))
            return True
        except OSError:
            time.sleep(0.5)
        finally:
            s.close()
    return False


def pick_ports(base, n, log):
    ports = []
    for i in range(n):
        p = base + i
        while not port_free(p):
            p += 1000
            log.warn("端口 %d 被占用, 改用 %d" % (p - 1000, p))
        ports.append(p)
    return ports


